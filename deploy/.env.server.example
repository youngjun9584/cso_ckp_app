# 운영 서버에서 .env.server로 복사 후 실제 값으로 채운다. 이 파일은 예시이며 실행할 수 없다.
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST:5432/cso_ckp?sslmode=require
DATABASE_SSL=require
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
FILE_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
STORAGE_DRIVER=s3
S3_BUCKET=REPLACE_BUCKET
S3_REGION=ap-northeast-2
S3_KEY_PREFIX=uploads/users/ckp
S3_PUBLIC_BASE_URL=
LEGACY_IMAGE_URL_PREFIXES=
# 서버의 IAM 역할을 사용하면 비워 둔다. 키가 필요하면 운영 서버 파일에만 입력한다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
CLIENT_APPROVAL_REQUIRED_FOR_EDI=true
MEDICINE_FEE_VISIBLE=true
EDI_DEAL_TYPE=기존
PHOTO_MAX_BYTES=15728640
PHOTO_MIN_LONG_SIDE=400
LOG_LEVEL=info
