{
  "cli": { "appVersionSource": "remote" },
  "build": {
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_API_MODE": "live",
        "EXPO_PUBLIC_API_BASE_URL": "https://ckpno1.com"
      },
      "android": { "buildType": "apk" }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_MODE": "live",
        "EXPO_PUBLIC_API_BASE_URL": "https://ckpno1.com"
      }
    }
  },
  "submit": { "production": {} }
}
