{
  "expo": {
    "name": "CKP",
    "slug": "ckp",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "ckp",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F3F5F8",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.ckp.app",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDevelopmentRegion": "ko",
        "CFBundleLocalizations": [
          "ko"
        ],
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "ko": {
        "ios": {
          "NSCameraUsageDescription": "EDI 증빙 사진을 촬영하려면 카메라 접근 권한이 필요합니다.",
          "NSPhotoLibraryUsageDescription": "EDI 증빙 사진을 선택하려면 사진 보관함 접근 권한이 필요합니다."
        }
      }
    },
    "android": {
      "package": "com.ckp.cso",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "CKP",
      "shortName": "CKP",
      "lang": "ko",
      "themeColor": "#0F2342",
      "backgroundColor": "#F3F5F8"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F2342",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "EDI 증빙 사진을 선택하려면 사진 보관함 접근 권한이 필요합니다.",
          "cameraPermission": "EDI 증빙 사진을 촬영하려면 카메라 접근 권한이 필요합니다.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ecce869a-41ab-44bf-854a-3dc1cd2be244"
      }
    },
    "owner": "parkbears-team"
  }
}
