{
  "name": "ckp-server",
  "version": "1.0.0",
  "private": true,
  "description": "CKP 업무 앱 API 서버 (인증·권한·업무 처리)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "dev:once": "tsx --env-file-if-exists=.env src/index.ts",
    "dev:reset": "node --env-file-if-exists=.env tools/dev-reset.mjs",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "tsc -p tsconfig.build.json && node tools/copy-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:contract": "node tools/check-contract.mjs",
    "db:check": "tsx --env-file-if-exists=.env src/scripts/db-check.ts",
    "db:match-managers": "tsx --env-file-if-exists=.env src/scripts/db-match-managers.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/scripts/db-migrate.ts",
    "cleanup:uploads": "tsx --env-file-if-exists=.env src/scripts/cleanup-uploads.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1139.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.5",
    "iconv-lite": "^0.7.3",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
