# ─────────────────────────────────────────────────────────────────────────────
# CKP API 서버 환경변수 예시 (개발용 기본값)
#   cp .env.example .env  후 npm run dev
#   실제 운영 값(DB 비밀번호, 비밀키, AWS 키)은 절대 이 파일이나 저장소에 커밋하지 마세요.
# ─────────────────────────────────────────────────────────────────────────────

# 서버 포트 / 바인딩 주소
PORT=4000
HOST=0.0.0.0

# 실행 환경: development | production | test
#   운영 서버에서는 반드시 production 으로 바꾸세요(비밀키·쿠키·DB 암호화 확인이 켜집니다).
#   Windows(cmd/PowerShell)에서는 'NODE_ENV=production npm start' 형식이 동작하지 않으므로 이 파일(.env)에 적습니다.
NODE_ENV=development

# 로그 수준: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ── 데이터베이스 ──────────────────────────────────────────────────────────────
# 운영: postgres://<계정>:<비밀번호>@<호스트>:5432/cso_ckp  (비워 두면 아래 DEV_DB 사용)
DATABASE_URL=
# DB SSL: require(암호화, 인증서 검증 안 함) | verify-full(인증서 검증) | disable(암호화 안 함)
#   비워 두면 DATABASE_URL 의 sslmode 를 따르고, 그것도 없으면 운영 require / 개발 disable.
#   DATABASE_URL 에 sslmode=require 를 적고 여기를 disable 로 두면 설정 오류로 시작하지 않습니다.
DATABASE_SSL=

# 개발용 내장 DB(PGlite). DATABASE_URL 이 비어 있을 때만 사용. 운영(production)에서는 사용할 수 없습니다.
DEV_DB=pglite
# 개발용 DB 데이터 폴더 (지우면 샘플 데이터로 다시 초기화됩니다: npm run dev:reset)
DEV_DB_DIR=.data/pglite

# ── 인증 ──────────────────────────────────────────────────────────────────────
# JWT 서명 비밀키(32자 이상). 아래 값은 개발 전용입니다. 운영에서는 반드시 새 임의 값으로 바꾸세요.
JWT_SECRET=dev-only-jwt-secret-7f3a9c2e5b8d41f6a0c9e2b5d8f1a4c7
# 사진 조회 서명 토큰 비밀키(32자 이상, JWT_SECRET 과 다른 값). 개발 전용 값입니다.
FILE_TOKEN_SECRET=dev-only-file-token-secret-3b6e9a1d4c7f02e5b8a1d4c7e0f3a6b9
# access 토큰 유효 시간(분) / refresh 토큰 유효 기간(일)
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=14
# 로그인 시 MD5 비밀번호를 bcrypt 로 다시 저장할지 여부 (구 앱이 MD5 만 검증하므로 기본 false)
PASSWORD_REHASH_ON_LOGIN=false

# ── 웹 접근 허용 ─────────────────────────────────────────────────────────────
# 웹 앱 주소(쉼표로 여러 개). '*' 는 사용할 수 없습니다. 예: http://localhost:8081,https://app.example.com
CORS_ORIGINS=http://localhost:8081
# refresh 쿠키(ckp_rt)에 Secure 속성 사용 여부. 비워 두면 운영 true / 개발 false. 운영에서 false 는 거부됩니다.
COOKIE_SECURE=
# 프록시(ALB·Nginx 등) 뒤에서 실행할 때 신뢰할 프록시: 앞단 프록시 수(예: 1) 또는 프록시 IP/CIDR 목록(쉼표, 예: 10.0.0.0/8)
#   - 프록시 없이 직접 받으면 false(기본).
#   - true 는 클라이언트가 보낸 X-Forwarded-For 를 그대로 믿어 로그인 시도 제한을 우회할 수 있으므로 운영에서 거부됩니다.
#   - 숫자·CIDR 로 설정해도 X-Forwarded-Proto/Host 는 반영되어 사진 URL 이 https 주소로 만들어집니다.
TRUST_PROXY=false
# 로그인 요청 IP당 1분 최대 횟수(아이디와 무관). 사무실 NAT 뒤 여러 명이 동시에 로그인하면 늘리세요.
#   (그 밖에: IP+아이디당 10회/분, 실패 아이디+IP 5회/10분, 실패 아이디 20회/10분)
LOGIN_IP_MAX_PER_MIN=30
# 개발용 비밀키(dev-only…)로 실제 DB(DATABASE_URL)에 서버를 띄우는 것은 기본 거부됩니다.
# 내 PC 의 개발용 PostgreSQL 에 접속할 때만 true 로 두세요. (db:check·db:migrate 스크립트에는 적용되지 않음)
ALLOW_DEV_SECRETS=
# 사진 조회 URL 을 만들 때 사용할 공개 주소(선택). 비우면 요청 주소(Host)를 사용합니다. 예: https://api.example.com
PUBLIC_BASE_URL=

# ── 사진 저장소 ──────────────────────────────────────────────────────────────
# local(개발: 서버 디스크) | s3(운영)
STORAGE_DRIVER=local
# 로컬 저장소 폴더
LOCAL_STORAGE_DIR=.data/uploads
# S3 버킷 / 리전 / 저장 경로 접두어
S3_BUCKET=
S3_REGION=ap-northeast-2
S3_KEY_PREFIX=uploads/users/ckp
# 관리자 화면이 읽을 공개 URL 기준 주소(비우면 https://<버킷>.s3.<리전>.amazonaws.com)
S3_PUBLIC_BASE_URL=
# AWS 자격 증명 (EC2/ECS 에서는 IAM 역할 사용 권장 → 비워 두세요)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 관리자/이전 방식으로 등록된 사진 중 서버가 대신 가져와 보여줄 수 있는 https 주소 접두어(쉼표)
# 비워 두면 기존 S3 사진(edi.aws_url)이 앱에서 보이지 않는다. 기존 EDI 버킷을 그대로 쓰면 아래 값 유지.
LEGACY_IMAGE_URL_PREFIXES=https://edi-img.s3.ap-northeast-2.amazonaws.com/

# ── 업무 설정 ────────────────────────────────────────────────────────────────
# 사진 1장 최대 크기(바이트, 기본 15MB) / 긴 변 최소 픽셀
PHOTO_MAX_BYTES=15728640
PHOTO_MIN_LONG_SIDE=400
# true: 승인되지 않은(승인대기) 거래처는 EDI 등록에 선택할 수 없음 (기존 업무 규칙)
CLIENT_APPROVAL_REQUIRED_FOR_EDI=true
# 의약품 수수료(frees.list=true 인 수수료 컬럼) 표시 여부
MEDICINE_FEE_VISIBLE=true
# 앱에서 등록한 EDI 행의 거래유형(edi.deal_type) 값
EDI_DEAL_TYPE=기존

# ── 회원가입(앱 로그인 화면의 가입 신청) ─────────────────────────────────────
# 앱에서 회원가입을 받을지 여부. 가입 신청은 승인 대기(apr_yn='N')로 저장되고,
# 관리자가 기존 관리자 화면(앱 회원 관리)에서 승인(apr_yn='Y')해야 로그인할 수 있습니다.
#   false 로 두면 가입·아이디 확인 요청이 거부되고(403) 앱 로그인 화면의 가입 링크가 숨겨집니다.
SELF_REGISTRATION_ENABLED=true
# 가입 신청 계정에 넣을 역할 코드(sys_role_mng.role_id, 5자 이하). R0004 = 일반사용자(구 앱과 동일)
#   이 줄을 지우면 R0004, 값을 비워 두면(REGISTER_ROLE_ID=) 역할 없이(NULL) 저장합니다.
REGISTER_ROLE_ID=R0004
# 같은 IP 에서 10분 동안 보낼 수 있는 가입 요청 수(성공·실패 모두 포함). 사무실 NAT 뒤에서 여러 명이 한꺼번에 가입하면 늘리세요.
REGISTER_IP_MAX_PER_10MIN=5
# 서버 전체에서 1시간 동안 완료할 수 있는 가입 신청 수(가짜 가입이 대량으로 쌓이는 것을 막는 안전장치)
REGISTER_MAX_PER_HOUR=100
